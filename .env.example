# MIKHLAFI LABS — Enterprise Platform Environment Variables Template
# All secrets must be provided at deployment time via secret managers or secure environment variables.
# NEVER commit raw values to source control.

# Application Server (Fastify API)
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Primary Relational Database (PostgreSQL 16+)
DATABASE_URL=postgresql://mikhlafi_user:mikhlafi_password@localhost:5432/mikhlafi_platform?sslmode=prefer
DATABASE_MAX_CONNECTIONS=20

# Caching, Sessions & Job Processing (Redis 7+)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Session Security & Tokens
SESSION_SECRET=replace_with_64_character_cryptographically_secure_random_string
JWT_ACCESS_SECRET=replace_with_64_character_access_secret
JWT_REFRESH_SECRET=replace_with_64_character_refresh_secret
COOKIE_SECRET=replace_with_64_character_cookie_secret
COOKIE_SECURE=false

# Platform Tenant Defaults
DEFAULT_LOCALE=ar
DEFAULT_CURRENCY=SAR
DEFAULT_TIMEZONE=Asia/Riyadh

# AI Provider Abstraction (Cloud or Local Ollama)
AI_PROVIDER=local_mock # options: local_mock, ollama, gemini
AI_LOCAL_ENDPOINT=http://localhost:11434
AI_MODEL_NAME=llama3.1
AI_CLOUD_API_KEY=

# Email Delivery (SMTP for On-Premise or Cloud)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mikhlafi-labs.com
