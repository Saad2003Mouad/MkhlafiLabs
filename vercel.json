{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "platform": {
      "root": "apps/platform",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api",
        "path": "/api/$1"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "platform",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/brand/(.*)",
      "destination": {
        "service": "platform",
        "path": "/brand/$1"
      }
    },
    {
      "source": "/(.*\\.(?:ico|png|svg|jpg|jpeg|webp|json|js|css|woff2|woff|ttf))",
      "destination": {
        "service": "platform",
        "path": "/$1"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": {
        "service": "platform",
        "path": "/index.html"
      }
    }
  ]
}
