{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "runtime": "node",
      "entrypoint": "src/index.js"
    },
    "platform": {
      "root": "apps/platform",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "platform",
        "path": "/assets/$1"
      }
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|jpeg|svg|ico|json|woff2?|webp|txt|xml|webmanifest))",
      "destination": {
        "service": "platform",
        "path": "/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "platform",
        "path": "/index.html"
      }
    }
  ]
}
